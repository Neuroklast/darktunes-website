{
  "name": "darktunes-website",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "kill": "fuser -k 3000/tcp",
    "build": "next build --webpack",
    "lint": "eslint --cache --cache-location .eslintcache app src tests scripts supabase proxy.ts playwright.config.ts next.config.ts vitest.config.ts global.d.ts",
    "check:scroll": "node scripts/check-scroll-contract.mjs",
    "check:overlay": "node scripts/check-overlay-stack-contract.mjs",
    "check:mobile-layout": "node scripts/check-mobile-layout-contract.mjs",
    "check:brand": "node scripts/check-brand-contract.mjs",
    "check:i18n": "node scripts/check-i18n-contract.mjs",
    "check:i18n:baseline": "node scripts/check-i18n-contract.mjs --write-baseline",
    "ci:contracts": "npm run lint && npm run check:scroll && npm run check:overlay && npm run check:mobile-layout && npm run check:brand && npm run check:i18n && npm run verify:portal-rls && npm run verify:schema-columns && npm run verify:api-contracts",
    "ci:typecheck": "npx tsc --noEmit",
    "ci:tests": "npm run test && npm run build",
    "ci": "npm run ci:contracts && npm run ci:typecheck && npm run ci:tests",
    "preview": "next start",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:tag": "node scripts/release.mjs tag",
    "validate:rbac": "npx tsx scripts/validate-rbac.ts",
    "verify:portal-rls": "node scripts/verify-portal-rls.mjs",
    "verify:schema-columns": "node scripts/verify-schema-columns.mjs",
    "verify:api-contracts": "node scripts/verify-api-contracts.mjs",
    "api:inventory": "node scripts/extract-api-routes.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:e2e:start": "node scripts/e2e-db-setup.mjs",
    "db:e2e:stop": "npx --yes supabase stop",
    "db:e2e:reset": "npx --yes supabase stop --no-backup && node scripts/e2e-db-setup.mjs",
    "analyze": "ANALYZE=true npm run build",
    "perf:bundle": "npm run analyze",
    "perf:dev": "next dev --turbo",
    "perf:build": "next build --profile",
    "perf:analyze": "ANALYZE=true npm run build",
    "perf:lighthouse": "node_modules/.bin/lhci collect --config=lighthouserc.cjs && node_modules/.bin/lhci assert --config=lighthouserc.cjs",
    "perf:test": "playwright test tests/performance"
  },
