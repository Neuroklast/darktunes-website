# .env.e2e.local — generated automatically by `npm run db:e2e:start`.
# Do NOT hand-fill this in and do NOT commit it (already gitignored via *.local).
#
# This documents the shape of the file so it's obvious what the script writes.
# All values point at the Supabase CLI's local Docker stack (see
# supabase/config.toml), never at production/staging.
#
# Run `npm run db:e2e:start` once before `npm run test:e2e` — this file must
# already exist when playwright.config.ts loads it, since Playwright starts
# the Next.js webServer before tests/e2e/global-setup.ts runs (see that file's
# header comment). global-setup.ts then just checks the stack is up/healthy
# and re-seeds the fixture users on every run; it does not create this file.
#
# By default the stack keeps running after `npm run test:e2e` finishes (fast
# re-runs during local dev). Set E2E_STOP_DB_AFTER_TESTS=1 to have
# tests/e2e/global-teardown.ts run `supabase stop` when the run ends
# (intended for CI).

# Local Supabase stack (from `supabase status -o json`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection — for tests that need to bypass PostgREST's
# public-schema-only exposure (e.g. tests/e2e/rls-validation.spec.ts querying
# pg_catalog for RLS status).
SUPABASE_DB_URL=

# Fixture accounts bootstrapped by scripts/e2e-db-setup.mjs
# (see tests/helpers/auth.ts for how these are consumed)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ARTIST_EMAIL=
E2E_ARTIST_PASSWORD=
E2E_JOURNALIST_EMAIL=
E2E_JOURNALIST_PASSWORD=

# Back-compat with tests/e2e/portal.spec.ts, which reads these directly
# instead of going through tests/helpers/auth.ts (same artist fixture account)
PLAYWRIGHT_PORTAL_EMAIL=
PLAYWRIGHT_PORTAL_PASSWORD=
